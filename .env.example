# ── Site ─────────────────────────────────────────────────────────────
# Your live domain, no trailing slash. Used for SEO, sitemap and Paystack redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Supabase (Dashboard → Project Settings → API) ────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The "anon" / "publishable" key. Safe to expose in the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# The "service_role" / "secret" key. SERVER ONLY. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Paystack (Dashboard → Settings → API Keys & Webhooks) ────────────
# Use sk_test_... while testing, sk_live_... when you go live. SERVER ONLY.
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
